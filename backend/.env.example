# ==============================================================================
# FloodSight Himalaya — Backend Environment Configuration (.env.example)
# Copy this file to .env and fill in values. Never commit .env to git.
# ==============================================================================

# Server & Application Settings
ENVIRONMENT=development
DEBUG=true
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
PIPELINE_MODE=mock # mock | live (default mock)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:8081,http://127.0.0.1:8082

# Storage & Data Directories
DATA_DIR=backend/data

# LLM Configuration (for copilot)
LLM_PROVIDER=            # anthropic | (empty = FakeLLM, no network calls)
LLM_API_KEY=             # your Anthropic API key (never share or commit)
LLM_MODEL=claude-haiku-5-5  # model ID — see https://docs.anthropic.com/en/docs/about-claude/models/overview

# Satellite Data Credentials (for future prompts)
COPERNICUS_USER=
COPERNICUS_PASSWORD=
PLANETARY_COMPUTER_API_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Geospatial & OpenStreetMap Services
MAPBOX_ACCESS_TOKEN=
OVERPASS_API_URL=
